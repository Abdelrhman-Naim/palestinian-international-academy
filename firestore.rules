rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Library Collection
    match /library/{bookId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Config Collection (Categories, Hero Featured, Maintenance, etc.)
    match /config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    // Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow read, write: if request.auth != null;
    }

    // Submissions Collection
    match /submissions/{submissionId} {
      allow read, write: if request.auth != null;
    }

    // Exams Collection
    match /exams/{examId} {
      allow read, write: if request.auth != null;
    }

    // Certificates Collection
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Saved Books Collection
    match /saved_books/{docId} {
      allow read, write: if request.auth != null;
    }

    // Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Instructor Requests Collection
    match /instructor_requests/{requestId} {
      allow read, write: if request.auth != null;
    }

    // Activity Logs Collection
    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Calls Collection (Voice & Video Calling)
    match /calls/{callId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

